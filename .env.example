# Conduit 환경변수 예시 — 복사해서 .env 로 사용하세요
# cp .env.example .env

# 외부 노출 포트 (기본 8787)
CONDUIT_PORT=8787

# API 인증 키 — /api/* 와 /mcp 요청에 필요 (Authorization: Bearer <키>)
# 비워 두면 이 컴퓨터(127.0.0.1)에서 온 요청만 허용한다. Docker·서버 배포 시에는 반드시 설정.
# 예: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CONDUIT_API_KEY=

# 서버에서 사용자 코드 실행 (코드 노드 · {{ }} JS 표현식 · 에이전트 run_code)
# 비워 두면: API 키가 없을 때 켜짐, 있을 때 꺼짐. 꺼지면 표현식은 $json.a.b 같은 데이터 경로만 허용.
CONDUIT_ALLOW_CODE=

# 자동 승인 게이트 — AI 출력이 승인 노드 없이 발송 노드(텔레그램·Slack·Gmail·Notion·POST·MCP)로 가면 발송 직전에 멈추고 사람에게 묻는다.
# 기본 켜짐(auto). 끄려면 off 를 명시. (끄면 AI 초안이 검토 없이 나갈 수 있다)
CONDUIT_AI_GATE=

# 타임존 (스케줄 트리거 크론이 이 기준으로 동작)
TZ=Asia/Seoul

# ---------- 모델 ----------
# 키 없이 쓰기: PC 에 Ollama 가 켜져 있으면 아무 설정 없이 자동으로 그 모델을 씁니다 (http://localhost:11434).
#   설치: https://ollama.com → 터미널에서 `ollama pull gemma3:4b` (약 3.3GB, 한국어·이미지 입력 가능, 생각 없이 바로 답함)
# 다른 OpenAI 호환 서버(LM Studio · llama.cpp · vLLM · 사내 게이트웨이)를 쓰려면 주소와 모델을 지정합니다.
CONDUIT_LLM_BASE_URL=
CONDUIT_LLM_MODEL=
CONDUIT_LLM_API_KEY=

# Claude 를 쓰려면 키를 넣습니다 (키가 있으면 Claude 가 우선, UI 의 "쉬운 시작" 에서 바꿀 수 있음)
# UI의 "자격 증명"에 anthropic 타입으로 저장해도 됩니다.
# 입력 도우미: set-anthropic-key.cmd 더블클릭 (키가 화면에 보이지 않고, 저장 전에 키를 확인한다)
ANTHROPIC_API_KEY=

# 하트비트 — 목표를 보고 스스로 일을 시작한다 (크론식, 비우면 꺼짐). 예: */10 * * * * = 10분마다
CONDUIT_HEARTBEAT=

# 동시 실행 상한
CONDUIT_CONCURRENCY=10

# 텔레그램 — 사람 승인 게이트 · 텔레그램 메시지 노드
# 봇: @BotFather 에서 /newbot → 토큰. 채팅 ID: 봇에게 /id 를 보내면 알려준다 (쉼표로 여러 개 = 허용 목록)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Front-end: e-mail shown in the UI (optional)
VITE_USER_EMAIL=

# 번호판 인식 서버 (yolo11 저장소의 plate_server.py)
# 비우면 http://localhost:5000 을 본다. 서버가 없으면 노드는 시뮬레이션으로 동작.
CONDUIT_PLATE_SERVER=
