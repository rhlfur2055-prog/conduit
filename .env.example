# Conduit 환경변수 예시 — 복사해서 .env 로 사용하세요
# cp .env.example .env

# 외부 노출 포트 (기본 8787)
CONDUIT_PORT=8787

# 타임존 (스케줄 트리거 크론이 이 기준으로 동작)
TZ=Asia/Seoul

# 실제 Claude 호출용 키 (없으면 AI 노드는 시뮬레이션 모드)
# UI의 "자격 증명"에 anthropic 타입으로 저장해도 됩니다.
ANTHROPIC_API_KEY=

# 동시 실행 상한
CONDUIT_CONCURRENCY=10

# 쿠팡 파트너스 Open API (partners.coupang.com → 링크 생성 → Open API)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=

# Blogger 자동 발행 (Blogger API v3 · scope=blogger 리프레시 토큰)
BLOGGER_REFRESH_TOKEN=
BLOGGER_BLOG_ID=

# 알리익스프레스 어필리에이트 (portals.aliexpress.com → Tools > API)
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=

# 링크프라이스 (linkprice.com 어필리에이트 · A코드/인증키)
LINKPRICE_A_ID=
LINKPRICE_AUTH_KEY=
LINKPRICE_U_ID=

# Front-end: e-mail shown in the UI (optional)
VITE_USER_EMAIL=
