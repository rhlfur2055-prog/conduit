# Conduit 환경변수 예시 — 복사해서 .env 로 사용하세요
# cp .env.example .env

# 외부 노출 포트 (기본 8787)
CONDUIT_PORT=8787

# API 인증 키 — /api/* 와 /mcp 요청에 필요 (Authorization: Bearer <키>)
# 비워 두면 이 컴퓨터(127.0.0.1)에서 온 요청만 허용한다. Docker·서버 배포 시에는 반드시 설정.
# 예: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CONDUIT_API_KEY=

# 서버에서 사용자 코드 실행 (코드 노드 · {{ }} JS 표현식 · 에이전트 run_code)
# 비워 두면: API 키가 없을 때 켜짐, 있을 때 꺼짐. 꺼지면 표현식은 $json.a.b 같은 데이터 경로만 허용.
CONDUIT_ALLOW_CODE=

# 타임존 (스케줄 트리거 크론이 이 기준으로 동작)
TZ=Asia/Seoul

# 실제 Claude 호출용 키 (없으면 AI 노드는 시뮬레이션 모드)
# UI의 "자격 증명"에 anthropic 타입으로 저장해도 됩니다.
ANTHROPIC_API_KEY=

# 동시 실행 상한
CONDUIT_CONCURRENCY=10

# 쿠팡 파트너스 Open API (partners.coupang.com → 링크 생성 → Open API)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=

# Blogger 자동 발행 (Blogger API v3 · scope=blogger 리프레시 토큰)
BLOGGER_REFRESH_TOKEN=
BLOGGER_BLOG_ID=

# 알리익스프레스 어필리에이트 (portals.aliexpress.com → Tools > API)
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=

# 링크프라이스 (linkprice.com 어필리에이트 · A코드/인증키)
LINKPRICE_A_ID=
LINKPRICE_AUTH_KEY=
LINKPRICE_U_ID=

# 텔레그램 — 사람 승인 게이트 · 텔레그램 메시지 노드
# 봇: @BotFather 에서 /newbot → 토큰. 채팅 ID: 봇에게 /id 를 보내면 알려준다 (쉼표로 여러 개 = 허용 목록)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Front-end: e-mail shown in the UI (optional)
VITE_USER_EMAIL=

# 영상 파이프라인 (Remotion 템플릿 프로젝트 위치)
# 비워 두면 이 저장소 옆의 ../video-pipeline 을 본다. 없으면 렌더 노드는 시뮬레이션으로 동작.
CONDUIT_VIDEO_PIPELINE_DIR=

# 번호판 인식 서버 (yolo11 저장소의 plate_server.py)
# 비우면 http://localhost:5000 을 본다. 서버가 없으면 노드는 시뮬레이션으로 동작.
CONDUIT_PLATE_SERVER=
